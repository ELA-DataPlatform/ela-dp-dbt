[sqlfluff]
templater = jinja
dialect = bigquery
max_line_length = 120
large_file_skip_byte_limit = 60000
# RF02 désactivé : trop bruyant avec les modèles dbt ({{ this }}, {{ ref() }})
# RF01 désactivé : faux positifs sur CROSS JOIN UNNEST BigQuery (SQLFluff ne résout pas le scope du tableau parent)
exclude_rules = RF02,RF01

[sqlfluff:templater:jinja]
# Shared offline rendering for local commands, pre-commit and CI.
load_macros_from_path = macros/garmin_health_timestamp.sql,macros/garmin_health_qualify_samples.sql,macros/garmin_activity_number.sql

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
indented_joins = false
indented_ctes = false
indented_on_contents = true

[sqlfluff:layout:type:comma]
line_position = trailing

# Capitalisation — UPPERCASE pour les mots-clés, fonctions, types et litéraux
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
capitalisation_policy = upper

# Aliasing — toujours utiliser AS explicitement
[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit

[sqlfluff:rules:aliasing.length]
min_alias_length = 1

# Convention
[sqlfluff:rules:convention.terminator]
multiline_newline = true
require_final_semicolon = false

# Ambiguous
[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent
